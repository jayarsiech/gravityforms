add_action("gform_after_submission_76", "add_two_days_arzesh_date", 10, 2);
function add_two_days_arzesh_date($entry, $form){
    $entry_id = $entry['id'];
    $user_id = rgar($entry, 'created_by');
    $entry_date = current_time('mysql');
       // اضافه کردن 2 روز به تاریخ
    $day1_date = date_create($entry_date);
    $day3_date = date_create($entry_date);
    $day6_date = date_create($entry_date);
    $day15_date = date_create($entry_date);
    $day30_date = date_create($entry_date);
    
    date_add($day1_date, date_interval_create_from_date_string('1 days'));
    $updated_date_1day = date_format($day1_date, 'Y-m-d H:i:s');
    
    date_add($day3_date, date_interval_create_from_date_string('3 days'));
    $updated_date_3day = date_format($day3_date, 'Y-m-d H:i:s');
    
    date_add($day6_date, date_interval_create_from_date_string('6 days'));
    $updated_date_6day = date_format($day6_date, 'Y-m-d H:i:s');
    
    date_add($day15_date, date_interval_create_from_date_string('15 days'));
    $updated_date_15day = date_format($day15_date, 'Y-m-d H:i:s');
    
    date_add($day30_date, date_interval_create_from_date_string('30 days'));
    $updated_date_30day = date_format($day30_date, 'Y-m-d H:i:s');
    
    
    // ذخیره تاریخ جدید به عنوان user meta با کلید "next_check_date"
    update_user_meta($user_id, '1day_check_date_arzesh', $updated_date_1day);
    update_user_meta($user_id, '3day_check_date_arzesh', $updated_date_3day);
    update_user_meta($user_id, '6day_check_date_arzesh', $updated_date_6day);
    update_user_meta($user_id, '15day_check_date_arzesh', $updated_date_15day);
    update_user_meta($user_id, '30day_check_date_arzesh', $updated_date_30day);    
}
