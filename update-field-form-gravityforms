function list_nicknames_by_moshaver() {
    global $wpdb; // متغیر دیتابیس وردپرس
    
    // نام جدول
    $table_name = $wpdb->prefix . 'jay_reserv_karshenas';
    
    // ساخت کوئری
    $query = $wpdb->prepare("SELECT nickname FROM $table_name WHERE moshaver = %d", 1);
    
    // اجرای کوئری
    $results = $wpdb->get_results($query);
    
    // چک کردن برای وجود نتایج
    if ($results) {
        $form_id = 12; // شماره فرم گراویتی
        
        // پیدا کردن فیلد چک باکس با ID 13
        $form = GFAPI::get_form($form_id);
        $field = GFAPI::get_field($form, 32);
        
        // اگر فیلد چک باکس با ID 13 وجود داشته باشد
        if ($field) {
            $choices = [];
            
            foreach ($results as $result) {
                $choices[] = [
                    'text' => $result->nickname,
                    'value' => $result->nickname,
                    'isSelected' => false,
                    'price' => ''
                ];
            }
            
            // بروزرسانی گزینه‌های فیلد
            $field->choices = $choices;
            
            // بروزرسانی فیلد در فرم
            $result = GFAPI::update_form($form, $form_id);
            
            if ($result === true) {
                echo 'فرم با موفقیت بروزرسانی شد.';
            } else {
                echo 'خطا در بروزرسانی فرم: ' . $result->get_error_message();
            }
        } else {
            echo 'فیلد چک باکس با شناسه 13 یافت نشد.';
        }
        
    } else {
        echo 'هیچ nickname‌ای با مشاور 1 یافت نشد.';
    }
}
